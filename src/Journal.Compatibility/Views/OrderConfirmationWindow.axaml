<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Jornal.Desktop.ViewModels" xmlns:ui="using:Jornal.Desktop.Controls"
        x:Class="Jornal.Desktop.Views.OrderConfirmationWindow" x:DataType="vm:OrderConfirmationViewModel"
        Title="{Binding Title}" Width="600" Height="420" MinWidth="560" MinHeight="380" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Margin="24">
      <StackPanel Spacing="16">
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Details}" FontSize="15" TextWrapping="Wrap" IsVisible="{Binding !HasOutcome}" />
        <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Classes="muted" IsVisible="{Binding !HasOutcome}" />
        <TextBlock Text="{Binding Progress}" TextWrapping="Wrap" />
        <SelectableTextBlock Text="{Binding Outcome}" TextWrapping="Wrap" IsVisible="{Binding HasOutcome}" />
        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" Foreground="{DynamicResource JournalDangerForeground}" />
        <ui:WindowsSecurityHelp DataContext="{Binding AccessHostHelp}" />
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" Padding="24,16" Background="{DynamicResource JournalSurface}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
        <ui:JournalButton Label="{Binding CancelLabel}" Click="OnCancelClick" IsEnabled="{Binding !ConfirmCommand.IsRunning}" Classes="outline" />
        <ui:JournalButton x:Name="ConfirmButton" Label="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}"
                          Classes.primary="{Binding !IsDestructive}" Classes.danger="{Binding IsDestructive}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
