<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Jornal.Desktop.ViewModels" xmlns:ui="using:Jornal.Desktop.Controls"
        x:Class="Jornal.Desktop.Views.DeliveryNumberWindow" x:DataType="vm:DeliveryNumberViewModel"
        Title="Номер БЛЦБ · Journal" Width="560" Height="480" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TextBox.invalid">
      <Setter Property="BorderBrush" Value="{DynamicResource JournalDangerForeground}" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource JournalDangerForeground}" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="{DynamicResource JournalSurface}" BorderBrush="{DynamicResource JournalBorder}"
            BorderThickness="0,0,0,1" Padding="24,16">
      <StackPanel Spacing="4">
        <TextBlock Text="Номер БЛЦБ" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="{Binding SelectionDescription}" Classes="muted" />
      </StackPanel>
    </Border>
    <Grid Grid.Row="1" Margin="24,16" RowDefinitions="Auto,12,*,12,Auto,8,36,8,Auto" IsEnabled="{Binding !SaveCommand.IsRunning}">
      <TextBlock IsVisible="{Binding HasDifferentNumbers}" Text="Разные номера — новое значение применится ко всем."
                 TextWrapping="Wrap" Foreground="{DynamicResource JournalAccent}" />
      <Border x:Name="SpecificationsPanel" Grid.Row="2" Classes="panel" Padding="12,8" MinHeight="40">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Specifications}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Margin="0,3" ToolTip.Tip="{Binding}" /></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
      <TextBlock Grid.Row="4" Text="БЛЦБ" FontWeight="SemiBold" />
      <Grid Grid.Row="6" ColumnDefinitions="*,8,Auto">
        <TextBox x:Name="DeliveryNumberInput" Text="{Binding Number, Mode=TwoWay}" MinHeight="36"
                 Classes.invalid="{Binding HasError}"
                 AutomationProperties.Name="Номер БЛЦБ для выбранных заявок" />
        <ui:JournalButton x:Name="ClearNumberButton" Grid.Column="2" Label="Очистить номер" Icon="x" Command="{Binding ClearNumberCommand}" />
      </Grid>
      <TextBlock x:Name="DeliveryNumberError" Grid.Row="8" Text="{Binding Error}" IsVisible="{Binding HasError}" Classes="error"
                 TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource JournalSurface}" BorderBrush="{DynamicResource JournalBorder}"
            BorderThickness="0,1,0,0" Padding="24,12">
      <Grid ColumnDefinitions="*,12,Auto,8,Auto" RowDefinitions="Auto,Auto">
        <TextBlock Text="{Binding StorageDescription}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
        <ui:JournalButton x:Name="CancelDeliveryButton" Grid.Column="2" Label="Отмена" Click="OnCancelClick" IsEnabled="{Binding !SaveCommand.IsRunning}" />
        <ui:JournalButton x:Name="SaveDeliveryButton" Grid.Column="4" Label="Сохранить" Icon="check" Classes="primary"
                          Command="{Binding SaveCommand}" IsDefault="True" />
        <ui:WindowsSecurityHelp Grid.Row="1" Grid.ColumnSpan="5" Margin="0,8,0,0" DataContext="{Binding AccessHostHelp}" />
      </Grid>
    </Border>
  </Grid>
</Window>
