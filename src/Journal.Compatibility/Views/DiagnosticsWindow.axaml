<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="using:Jornal.Desktop.Controls.Settings" xmlns:vm="using:Jornal.Desktop.ViewModels" xmlns:ui="using:Jornal.Desktop.Controls"
        x:Class="Jornal.Desktop.Views.DiagnosticsWindow" x:DataType="vm:DiagnosticsViewModel"
        Title="Диагностика · Journal" Width="620" Height="340" MinWidth="540" MinHeight="320" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto">
    <settings:DiagnosticsPanel x:Name="Page" />
    <Border Grid.Row="1" Background="{DynamicResource JournalSurface}" Padding="24,12">
      <ui:JournalButton x:Name="CloseDiagnosticsButton" Label="Закрыть" HorizontalAlignment="Right" Click="OnCloseClick" />
    </Border>
  </Grid>
</Window>
