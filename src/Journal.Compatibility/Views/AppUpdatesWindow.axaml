<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="using:Jornal.Desktop.Controls.Settings" xmlns:vm="using:Jornal.Desktop.ViewModels" xmlns:ui="using:Jornal.Desktop.Controls"
        x:Class="Jornal.Desktop.Views.AppUpdatesWindow" x:DataType="vm:AppUpdatesViewModel"
        Title="Обновления · Journal" Width="640" Height="580" MinWidth="600" MinHeight="540"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto">
    <settings:AppUpdatesPanel x:Name="Page" />
    <Border Grid.Row="1" Background="{DynamicResource JournalSurface}" Padding="24,12">
      <ui:JournalButton x:Name="CloseUpdatesButton" Label="Закрыть" HorizontalAlignment="Right" Click="OnCloseClick" />
    </Border>
  </Grid>
</Window>
