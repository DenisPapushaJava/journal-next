<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svg="clr-namespace:Avalonia.Svg;assembly=Svg.Controls.Avalonia" xmlns:vm="using:Jornal.Desktop.ViewModels" xmlns:ui="using:Jornal.Desktop.Controls"
        x:Class="Jornal.Desktop.Views.NewOrderWindow" x:DataType="vm:NewOrderViewModel"
        Title="{Binding WindowTitle}" Width="1240" Height="760" MinWidth="1060" MinHeight="600"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="Border#NewOrderSpecificationOverlay">
      <Setter Property="Background" Value="#60505C70" /><Setter Property="BorderBrush" Value="{DynamicResource JournalAccent}" />
    </Style>
    <Style Selector="Border#NewOrderSpecificationOverlay.rejected">
      <Setter Property="Background" Value="{DynamicResource JournalImportRejectionOverlay}" /><Setter Property="BorderBrush" Value="{DynamicResource JournalDangerForeground}" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBox.invalid">
      <Setter Property="BorderBrush" Value="{DynamicResource JournalDangerForeground}" />
    </Style>
    <Style Selector="TextBox.invalid:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource JournalDangerForeground}" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Background="{DynamicResource JournalSurface}" BorderBrush="{DynamicResource JournalBorder}"
            BorderThickness="0,0,0,1" Padding="24,8">
      <Grid ColumnDefinitions="*,12,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Heading}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding StorageDescription}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
        <ui:JournalButton x:Name="BrowseSpecificationButton" Grid.Column="2" Label="Открыть спецификацию" Icon="folder-plus"
                          IconOnly="True" Width="36" Height="36" Padding="0" VerticalAlignment="Center"
                          IsEnabled="{Binding CanAddFiles}" Click="OnBrowseSpecification" ToolTip.Tip="Добавить спецификации" />
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="24,8" ColumnDefinitions="*,24,260" IsVisible="{Binding !IsBatchMode}">
      <Border Classes="panel">
        <ScrollViewer x:Name="FormScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="FormFields" Margin="16,6" Spacing="3" IsEnabled="{Binding !IsBusy}">
            <TextBlock Text="Заявка и заказчик" Classes="section" />
            <Grid ColumnDefinitions="*,24,*">
              <ui:OrderEntryControl DataContext="{Binding OrderDate}" />
              <ui:OrderEntryControl Grid.Column="2" DataContext="{Binding SpecificationNumber}" />
            </Grid>
            <Grid ColumnDefinitions="*,24,*">
              <ui:OrderEntryControl DataContext="{Binding Manager}" />
              <ui:OrderEntryControl Grid.Column="2" DataContext="{Binding Customer}" />
            </Grid>
            <TextBlock Text="Параметры резки" Classes="section" Margin="0,4,0,0" />
            <Grid ColumnDefinitions="*,24,*">
              <ui:OrderEntryControl DataContext="{Binding CuttingType}" />
              <ui:OrderEntryControl Grid.Column="2" DataContext="{Binding Material}" />
            </Grid>
            <Grid ColumnDefinitions="*,24,*">
              <ui:OrderEntryControl DataContext="{Binding Thickness}" />
              <ui:OrderEntryControl Grid.Column="2" DataContext="{Binding SheetSize}" />
            </Grid>
            <Grid ColumnDefinitions="*,24,*">
              <ui:OrderEntryControl DataContext="{Binding SheetCount}" />
              <ui:OrderEntryControl Grid.Column="2" DataContext="{Binding Weight}" />
            </Grid>
            <Grid ColumnDefinitions="*,24,*">
              <ui:OrderEntryControl DataContext="{Binding CutLength}" />
              <ui:OrderEntryControl Grid.Column="2" DataContext="{Binding Coefficient}" />
            </Grid>
            <Grid ColumnDefinitions="*,24,*">
              <ui:OrderEntryControl x:Name="CuttingTimeInput" DataContext="{Binding CuttingTime}" />
            </Grid>
            <Grid ColumnDefinitions="*,24,*" IsVisible="{Binding IsHansLaser}">
              <ui:OrderEntryControl DataContext="{Binding MaterialId}" />
              <ui:OrderEntryControl Grid.Column="2" DataContext="{Binding Gas}" />
            </Grid>
            <ui:OrderAnnotationsControl DataContext="{Binding Annotations}" />
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border Grid.Column="2" Classes="panel" Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Стоимость" Classes="section" VerticalAlignment="Center" />
            <ui:JournalButton Grid.Column="1" x:Name="CalculatePriceButton" Label="Обновить тарифы" Icon="refresh-cw" IconOnly="True" Width="30" Height="30" Padding="0"
                              Command="{Binding CalculatePriceCommand}" IsVisible="{Binding HasPricing}" ToolTip.Tip="Обновить тарифы" />
          </Grid>
          <TextBlock Text="{Binding PriceText}" FontSize="18" FontWeight="Medium" />
          <TextBlock Text="{Binding PriceBreakdown}" Classes="muted" TextWrapping="Wrap" />
          <TextBlock Text="{Binding PriceError}" IsVisible="{Binding HasPriceError}"
                     Foreground="{DynamicResource JournalDangerForeground}" TextWrapping="Wrap" />
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsImporting}" Height="4" />
          <Border IsVisible="{Binding HasPendingImport}" Background="{DynamicResource JournalAccentSoft}" Padding="12" CornerRadius="6">
            <StackPanel Spacing="10">
              <TextBlock Text="Заменить параметры спецификации?" TextWrapping="Wrap" />
              <TextBlock Text="{Binding PendingImportName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PendingImportName}" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding ImportError}" IsVisible="{Binding HasImportError}" TextWrapping="Wrap" Foreground="{DynamicResource JournalDangerForeground}" />
          <StackPanel IsVisible="{Binding HasImport}" Spacing="8">
            <Border Height="1" Background="{DynamicResource JournalBorder}" Margin="0,8" />
            <TextBlock Text="Спецификация" Classes="section" />
            <TextBlock x:Name="ImportFileName" Text="{Binding ImportPreview.FileName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ImportPreview.FileName}" FontWeight="Medium" />
            <TextBlock Text="{Binding ImportPreview.Counts}" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ImportDiagnostics}" IsVisible="{Binding HasImportDiagnostics}" TextWrapping="Wrap"
                       Foreground="{DynamicResource JournalDangerForeground}" />
          </StackPanel>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <Grid Grid.Row="1" Margin="24,12" RowDefinitions="Auto,Auto,Auto,*" IsVisible="{Binding IsBatchMode}">
      <Grid ColumnDefinitions="*,24,*" IsEnabled="{Binding CanEditBatch}">
        <ui:OrderEntryControl DataContext="{Binding Manager}" />
        <ui:OrderEntryControl Grid.Column="2" DataContext="{Binding Customer}" />
      </Grid>
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,10,0,8">
        <TextBlock Text="{Binding BatchSummary}" Classes="muted" VerticalAlignment="Center" />
        <ui:JournalButton Grid.Column="1" x:Name="RefreshBatchTariffsButton" Label="Обновить тарифы" Icon="refresh-cw" Command="{Binding CalculatePriceCommand}" />
      </Grid>
      <TextBlock Grid.Row="2" Text="{Binding ImportError}" IsVisible="{Binding HasImportError}" TextWrapping="Wrap"
                 Foreground="{DynamicResource JournalDangerForeground}" Margin="0,0,0,8" />
      <ListBox x:Name="BatchCards" Grid.Row="3" ItemsSource="{Binding BatchItems}" Background="Transparent"
               BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:BatchSpecificationItem">
            <Border Classes="panel" Padding="16" Opacity="{Binding CardOpacity}">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,10,Auto,10,*,12,Auto,12,Auto">
                  <CheckBox IsChecked="{Binding IsIncluded}" IsEnabled="{Binding CanEdit}" MinHeight="28"
                            AutomationProperties.Name="Включить спецификацию" ToolTip.Tip="Включить в пакет" />
                  <Border Grid.Column="2" Background="{DynamicResource JournalSurface}" BorderBrush="{DynamicResource JournalBorder}"
                          BorderThickness="1" CornerRadius="5" Padding="7,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PositionLabel}" Foreground="{DynamicResource JournalMuted}" FontSize="12" />
                  </Border>
                  <TextBlock Grid.Column="4" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                             VerticalAlignment="Center" ToolTip.Tip="{Binding FileName}" />
                  <TextBlock Grid.Column="6" Text="{Binding Status}" Classes="muted" VerticalAlignment="Center" ToolTip.Tip="{Binding Details}" />
                  <ui:JournalButton Grid.Column="8" Label="Убрать файл" Icon="x" IconOnly="True" Width="28" Height="28" Padding="0"
                                    Command="{Binding RemoveCommand}" ToolTip.Tip="Убрать из пакета" />
                </Grid>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsReading}" Height="3" />
                <TextBlock Text="{Binding Failure}" IsVisible="{Binding HasFailure}" TextWrapping="Wrap"
                           Foreground="{DynamicResource JournalDangerForeground}" />
                <TextBlock Text="{Binding Warning}" IsVisible="{Binding HasWarning}" TextWrapping="Wrap" Classes="muted" />
                <TextBlock Text="{Binding Form.PriceError}" IsVisible="{Binding Form.HasPriceError}" TextWrapping="Wrap"
                           Foreground="{DynamicResource JournalDangerForeground}" />
                <StackPanel IsVisible="{Binding HasParameters}" Spacing="10" IsEnabled="{Binding CanEdit}">
                  <ui:OrderParametersControl DataContext="{Binding Form}" />
                  <TextBlock Text="{Binding Form.PriceText}" FontWeight="SemiBold" />
                  <ui:WindowsSecurityHelp DataContext="{Binding Form.AccessHostHelp}" />
                  <TextBlock Text="{Binding Form.SaveError}" IsVisible="{Binding Form.HasSaveError}" TextWrapping="Wrap"
                             Foreground="{DynamicResource JournalDangerForeground}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource JournalSurface}" BorderBrush="{DynamicResource JournalBorder}"
            BorderThickness="0,1,0,0" Padding="24,8">
      <Grid ColumnDefinitions="*,24,Auto" RowDefinitions="Auto,Auto">
        <StackPanel VerticalAlignment="Center" Spacing="4">
          <StackPanel x:Name="SaveProgress" Orientation="Horizontal" Spacing="8" IsVisible="{Binding SaveCommand.IsRunning}">
            <ProgressBar IsIndeterminate="True" Width="64" Height="4" VerticalAlignment="Center" />
            <TextBlock Text="Сохранение…" Foreground="{DynamicResource JournalMuted}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock x:Name="ValidationSummary" Text="Проверьте отмеченные поля."
                     IsVisible="{Binding HasValidationErrors}" Foreground="{DynamicResource JournalDangerForeground}" />
          <TextBlock Text="{Binding SaveError}" IsVisible="{Binding HasSaveError}"
                     Foreground="{DynamicResource JournalDangerForeground}" TextWrapping="Wrap" />
          <ui:JournalButton Label="Отменить чтение" Click="OnCancelFormImport" IsVisible="{Binding IsReadingSpecifications}" HorizontalAlignment="Left" />
          <WrapPanel IsVisible="{Binding HasPendingImport}">
            <ui:JournalButton Label="Заменить параметры" Command="{Binding ReplaceImportCommand}" Margin="0,0,8,0" />
            <ui:JournalButton Label="Оставить прежние" Command="{Binding CancelImportReplacementCommand}" />
          </WrapPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <ui:JournalButton x:Name="CancelButton" Label="Отмена" Classes="outline" MinHeight="38"
                            Click="OnCancelClick" IsEnabled="{Binding !SaveCommand.IsRunning}" />
          <ui:JournalButton x:Name="SaveButton" Label="{Binding SaveLabel}" Classes="primary" MinHeight="38"
                            IsEnabled="{Binding !SaveCommand.IsRunning}" Command="{Binding SaveCommand}" Click="OnSaveClick" IsDefault="True" />
        </StackPanel>
        <ui:WindowsSecurityHelp x:Name="OrderSecurityHelp" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0"
                                DataContext="{Binding AccessHostHelp}" />
      </Grid>
    </Border>
    <Border x:Name="NewOrderSpecificationOverlay" Grid.RowSpan="3" ZIndex="100" Classes.rejected="{Binding HasDropRejection}" IsVisible="{Binding IsDraggingFiles}"
            BorderThickness="2" CornerRadius="8" Margin="8">
      <Border IsVisible="{Binding HasDropRejection}" Background="{DynamicResource JournalDangerBackground}" BorderBrush="{DynamicResource JournalDangerForeground}"
              BorderThickness="1" CornerRadius="12" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Margin="24">
        <StackPanel Spacing="12">
          <svg:Svg Path="avares://Jornal.Desktop/Assets/Icons/ban.svg" Width="32" Height="32" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding DropRejection}" TextAlignment="Center" TextWrapping="Wrap" FontSize="18" Foreground="{DynamicResource JournalDangerForeground}" />
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
