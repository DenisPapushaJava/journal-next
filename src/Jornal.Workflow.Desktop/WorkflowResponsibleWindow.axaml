<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Jornal.Workflow.Core" xmlns:ui="using:Jornal.Desktop.Controls"
        x:Class="Jornal.Workflow.Desktop.WorkflowResponsibleWindow"
        Title="Сменить ответственного" Width="520" SizeToContent="Height" CanResize="False"
        Background="{DynamicResource JournalBackground}" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock Text="Сменить ответственного" FontSize="20" FontWeight="SemiBold" />
    <TextBlock x:Name="ResponsibleOrderTitle" Classes="muted" TextWrapping="Wrap" />
    <StackPanel Spacing="4">
      <TextBlock Text="Ответственный технолог" Classes="muted" />
      <ComboBox x:Name="ResponsibleEmployeeInput" HorizontalAlignment="Stretch" SelectionChanged="OnEmployeeChanged"
                AutomationProperties.Name="Ответственный технолог">
        <ComboBox.ItemTemplate><DataTemplate x:DataType="core:Employee"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <ui:JournalButton x:Name="CancelResponsibleChange" Label="Отмена" Click="OnCancel" />
      <ui:JournalButton x:Name="SaveResponsibleChange" Label="Сохранить" Classes="primary" Click="OnSave" IsEnabled="False" />
    </StackPanel>
  </StackPanel>
</Window>
