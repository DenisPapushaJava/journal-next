<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Jornal.Desktop.Controls" x:Class="Jornal.Workflow.Desktop.WorkflowProjectActionWindow"
        Width="620" MinWidth="520" SizeToContent="Height" CanResize="False"
        Background="{DynamicResource JournalBackground}" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock x:Name="ActionTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="ActionMessage" TextWrapping="Wrap" />
    <SelectableTextBlock x:Name="ActionDetails" TextWrapping="Wrap" MaxHeight="180" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <ui:JournalButton x:Name="CancelProjectAction" Click="OnCancel" />
      <ui:JournalButton x:Name="ConfirmProjectAction" Click="OnConfirm" />
    </StackPanel>
  </StackPanel>
</Window>
