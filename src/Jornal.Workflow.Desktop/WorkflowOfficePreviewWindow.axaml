<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Jornal.Workflow.Desktop" xmlns:ui="using:Jornal.Desktop.Controls"
        x:Class="Jornal.Workflow.Desktop.WorkflowOfficePreviewWindow"
        Title="Проверить заявки с сервера" Width="620" Height="500" MinWidth="440" MinHeight="420"
        Background="{DynamicResource JournalBackground}" WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TextBlock.office-preview-error">
      <Setter Property="Foreground" Value="{DynamicResource JournalDangerForeground}" />
    </Style>
  </Window.Styles>
  <Grid Margin="20" RowDefinitions="Auto,14,Auto,10,Auto,8,*,12,Auto">
    <TextBlock Text="Последние заявки · только просмотр" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
    <StackPanel x:Name="ConnectionFields" Grid.Row="2" Spacing="5">
      <Label Content="Адрес сервера" Target="{Binding #OfficePreviewAddress}" Padding="0" />
      <TextBox x:Name="OfficePreviewAddress" PlaceholderText="Вставьте адрес из панели сервера" MaxLength="160" />
      <Label Content="Ключ администратора" Target="{Binding #OfficePreviewKey}" Padding="0" />
      <TextBox x:Name="OfficePreviewKey" PasswordChar="●" MaxLength="128" />
    </StackPanel>
    <Grid Grid.Row="4" RowDefinitions="Auto,4">
      <TextBlock x:Name="OfficePreviewStatus" TextWrapping="Wrap" MinHeight="32" AutomationProperties.LiveSetting="Polite" />
      <ProgressBar x:Name="OfficePreviewProgress" Grid.Row="1" IsIndeterminate="True" IsVisible="False" Height="3" />
    </Grid>
    <DataGrid x:Name="OfficePreviewOrders" Grid.Row="6" AutoGenerateColumns="False" IsReadOnly="True"
              IsVisible="False" HeadersVisibility="Column" GridLinesVisibility="None" HorizontalScrollBarVisibility="Disabled"
              AutomationProperties.Name="Последние активные заявки">
      <DataGrid.Columns>
        <DataGridTextColumn x:DataType="vm:WorkflowOfficePreviewRow" Header="Номер заявки" Width="200" Binding="{Binding Number}" />
        <DataGridTextColumn x:DataType="vm:WorkflowOfficePreviewRow" Header="Заказчик" Width="*" Binding="{Binding Customer}" />
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="8" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <ui:JournalButton x:Name="RunOfficePreview" Label="Проверить" Classes="primary" IsDefault="True" Click="OnCheck" />
      <ui:JournalButton Label="Закрыть" IsCancel="True" Click="OnClose" />
    </StackPanel>
  </Grid>
</Window>
