<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Jornal.Workflow.Desktop" xmlns:ui="using:Jornal.Desktop.Controls"
        x:Class="Jornal.Workflow.Desktop.WorkflowTrashConfirmationWindow" x:DataType="vm:WorkflowTrashConfirmationViewModel"
        Title="Переместить заявку в корзину" Width="560" MinWidth="520" SizeToContent="Height" CanResize="False"
        Background="{DynamicResource JournalBackground}" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Customer}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Contents}" TextWrapping="Wrap" />
    <TextBlock Text="Заявка исчезнет из рабочего списка. Её можно восстановить из корзины. Папки и файлы проектов останутся на диске." Classes="muted" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource JournalDangerForeground}" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" IsEnabled="{Binding CanEdit}">
      <ui:JournalButton x:Name="CancelWorkflowTrash" Label="Отмена" Click="OnCancel" />
      <ui:JournalButton x:Name="ConfirmWorkflowTrash" Label="В корзину" Icon="trash" Click="OnConfirm" />
    </StackPanel>
  </StackPanel>
</Window>
