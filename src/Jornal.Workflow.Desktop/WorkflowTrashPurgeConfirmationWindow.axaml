<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Jornal.Workflow.Desktop" xmlns:ui="using:Jornal.Desktop.Controls"
        x:Class="Jornal.Workflow.Desktop.WorkflowTrashPurgeConfirmationWindow" x:DataType="vm:WorkflowTrashPurgeConfirmationViewModel"
        Title="{Binding Title}" Width="620" MinWidth="520" SizeToContent="Height" CanResize="False"
        Background="{DynamicResource JournalBackground}" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="16">
    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
      <TextBlock Text="{Binding Details}" TextWrapping="Wrap" />
    </ScrollViewer>
    <TextBlock Text="Заявки, их проекты, спецификации и расчёты будут удалены из программы. Восстановить их из корзины будет нельзя."
               Foreground="{DynamicResource JournalDangerForeground}" TextWrapping="Wrap" />
    <TextBlock Text="Рабочие папки, CAM-файлы и HTML/PDF останутся на диске." Classes="muted" TextWrapping="Wrap" />
    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource JournalDangerForeground}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <ui:JournalButton x:Name="CancelWorkflowPurge" Label="Отмена" Click="OnCancel" IsEnabled="{Binding CanClose}" />
      <ui:JournalButton x:Name="ConfirmWorkflowPurge" Label="{Binding ConfirmLabel}" Classes="danger" Click="OnConfirm" IsEnabled="{Binding CanConfirm}" />
    </StackPanel>
  </StackPanel>
</Window>
