<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Jornal.Workflow.Desktop.App" RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceInclude Source="avares://Jornal.Desktop/Themes/Palette.axaml" /></ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="JournalFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
      <ControlTheme x:Key="WorkflowTabularCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="FontFeatures" Value="tnum" />
      </ControlTheme>
      <ControlTheme x:Key="WorkflowNumericCell" TargetType="DataGridCell" BasedOn="{StaticResource WorkflowTabularCell}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
      </ControlTheme>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme><FluentTheme.Palettes><ColorPaletteResources x:Key="Light" Accent="#42668F" /><ColorPaletteResources x:Key="Dark" Accent="#99B5D3" /></FluentTheme.Palettes></FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://Jornal.Desktop/Themes/Journal.axaml" />
    <StyleInclude Source="avares://Jornal.Desktop/Themes/Inputs.axaml" />
    <StyleInclude Source="avares://Jornal.Desktop/Themes/Settings.axaml" />
    <StyleInclude Source="avares://Jornal.Desktop/Themes/Scrollbars.axaml" />
    <StyleInclude Source="avares://Jornal.Desktop/Themes/ContextMenus.axaml" />
    <Style Selector="TextBlock.tabular, TextBox.tabular, Button.tabular, ComboBox.tabular">
      <Setter Property="TextElement.FontFeatures" Value="tnum" />
    </Style>
    <Style Selector="DataGrid"><Setter Property="Background" Value="{DynamicResource JournalSurface}" /><Setter Property="RowHeight" Value="32" /></Style>
    <Style Selector="DataGridRow"><Setter Property="Background" Value="{DynamicResource JournalSurface}" /><Setter Property="Foreground" Value="{DynamicResource JournalText}" /></Style>
    <Style Selector="DataGridRow:pointerover"><Setter Property="Background" Value="{DynamicResource JournalRaised}" /></Style>
    <Style Selector="DataGridRow:selected, DataGridRow:selected:pointerover"><Setter Property="Background" Value="{DynamicResource JournalSelection}" /><Setter Property="Foreground" Value="{DynamicResource JournalText}" /></Style>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="14" /><Setter Property="Padding" Value="12,8" /></Style>
    <Style Selector="TextBox.field"><Setter Property="MinHeight" Value="32" /></Style>
    <Style Selector="GridSplitter.workflow-splitter">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent">
            <Border x:Name="WorkflowSplitterHandle" CornerRadius="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="GridSplitter.workflow-splitter /template/ Border#WorkflowSplitterHandle">
      <Setter Property="Background" Value="{DynamicResource JournalControlBorder}" />
      <Setter Property="Width" Value="3" /><Setter Property="Height" Value="40" />
    </Style>
    <Style Selector="GridSplitter.workflow-splitter.rows /template/ Border#WorkflowSplitterHandle">
      <Setter Property="Width" Value="40" /><Setter Property="Height" Value="3" />
    </Style>
    <Style Selector="GridSplitter.workflow-splitter:pointerover /template/ Border#WorkflowSplitterHandle, GridSplitter.workflow-splitter:pressed /template/ Border#WorkflowSplitterHandle, GridSplitter.workflow-splitter:focus-visible /template/ Border#WorkflowSplitterHandle">
      <Setter Property="Background" Value="{DynamicResource JournalAccent}" />
    </Style>
  </Application.Styles>
</Application>
