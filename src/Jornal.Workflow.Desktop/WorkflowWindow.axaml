<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Jornal.Workflow.Desktop" xmlns:core="using:Jornal.Workflow.Core" xmlns:ui="using:Jornal.Desktop.Controls"
        x:Class="Jornal.Workflow.Desktop.WorkflowWindow" x:DataType="vm:WorkflowViewModel"
        Title="{x:Static vm:WorkflowIdentity.WindowTitle}" Width="1480" Height="900" MinWidth="1180" MinHeight="720"
        Background="{DynamicResource JournalBackground}" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WorkflowExcludedBackground" Color="#F5F7FA" />
          <SolidColorBrush x:Key="WorkflowExcludedHover" Color="#EFF2F6" />
          <SolidColorBrush x:Key="WorkflowExcludedSelection" Color="#E8EDF3" />
          <SolidColorBrush x:Key="WorkflowExcludedText" Color="#8794A5" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WorkflowExcludedBackground" Color="#1B2027" />
          <SolidColorBrush x:Key="WorkflowExcludedHover" Color="#222A34" />
          <SolidColorBrush x:Key="WorkflowExcludedSelection" Color="#252F3C" />
          <SolidColorBrush x:Key="WorkflowExcludedText" Color="#7E8B9C" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <StreamGeometry x:Key="WorkflowFolderIcon">M3,4 H9 L11,6 H21 V9 H7 L3,18 Z M7,11 H23 L19,20 H3 Z</StreamGeometry>
    </ResourceDictionary>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="TextBlock.workflowProjectInfo">
      <Setter Property="Foreground" Value="{DynamicResource JournalText}" />
    </Style>
    <Style Selector="TextBlock.workflowProjectInfo.projectName">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.workflowProjectInfo.projectMaterial">
      <Setter Property="Foreground" Value="{DynamicResource JournalMuted}" />
    </Style>
    <Style Selector="TextBlock.workflowProjectInfo.excluded">
      <Setter Property="Foreground" Value="{DynamicResource WorkflowExcludedText}" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="DataGrid#WorkflowProjectsGrid DataGridRow.workflowProjectExcluded">
      <Setter Property="Background" Value="{DynamicResource WorkflowExcludedBackground}" />
      <Setter Property="Height" Value="40" />
      <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style Selector="DataGrid#WorkflowProjectsGrid DataGridRow.workflowProjectExcluded:pointerover">
      <Setter Property="Background" Value="{DynamicResource WorkflowExcludedHover}" />
    </Style>
    <Style Selector="DataGrid#WorkflowProjectsGrid DataGridRow.workflowProjectExcluded:selected, DataGrid#WorkflowProjectsGrid DataGridRow.workflowProjectExcluded:selected:pointerover">
      <Setter Property="Background" Value="{DynamicResource WorkflowExcludedSelection}" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="56,Auto,*,4,28">
    <Border Background="{DynamicResource JournalSurface}" BorderBrush="{DynamicResource JournalBorder}" BorderThickness="0,0,0,1" Padding="20,8">
      <Grid ColumnDefinitions="*,Auto,*">
        <StackPanel Spacing="1" VerticalAlignment="Center">
          <TextBlock Text="{x:Static vm:WorkflowIdentity.Name}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="Локальная разработка" Classes="muted" FontSize="11" />
        </StackPanel>
        <ui:HeaderClock x:Name="WorkflowHeaderClock" Grid.Column="1" MinWidth="200" Margin="12,0" FontFeatures="tnum" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
        <Grid Grid.Column="2" ColumnDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto" HorizontalAlignment="Right">
          <ui:JournalButton x:Name="WorkflowCatalog" Label="Станки и цены" Click="OnCatalog" IsEnabled="{Binding CanUse}" />
          <Border x:Name="WorkflowProfileBadge" Grid.Column="2" Width="130" Padding="9,6" CornerRadius="6" VerticalAlignment="Center"
                  Background="{DynamicResource JournalBackground}" BorderBrush="{DynamicResource JournalBorder}" BorderThickness="1"
                  ToolTip.Tip="{Binding ProfileHint}" AutomationProperties.Name="{Binding ProfileName}">
            <Grid ColumnDefinitions="12,7,*">
              <Border Width="10" Height="10" CornerRadius="5" Background="{Binding ProfileBrush}" BorderBrush="{DynamicResource JournalBorder}" BorderThickness="1" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding ProfileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ToggleButton x:Name="ThemeSwitch" Grid.Column="4" Theme="{StaticResource JournalThemeSwitch}" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" IsCheckedChanged="OnThemeChanged" VerticalAlignment="Center" ToolTip.Tip="Светлая / тёмная тема" />
          <ui:JournalButton x:Name="WorkflowSettings" Grid.Column="6" Icon="settings" IconOnly="True" Width="40" Height="36" Click="OnSettings" ToolTip.Tip="Настройки" IsEnabled="{Binding CanUse}" AutomationProperties.Name="Настройки" />
          <Grid Grid.Column="8">
            <ui:JournalButton x:Name="UpdatesBell" Icon="bell" IconOnly="True" Width="40" Height="36" Click="OnUpdates" ToolTip.Tip="{x:Static vm:WorkflowIdentity.UpdatesTitle}" />
            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource JournalAccent}" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding Updates.HasUpdate}" IsHitTestVisible="False" />
          </Grid>
        </Grid>
      </Grid>
    </Border>
    <TextBlock Grid.Row="1" Text="{Binding Error}" TextWrapping="Wrap" Margin="20,8,20,0" Foreground="{DynamicResource JournalDangerForeground}" />
    <Grid x:Name="JournalWorkspace" Grid.Row="2" Margin="20,12" IsEnabled="{Binding CanBrowseWorkspace}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="4*" MinWidth="368" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="6*" MinWidth="760" />
      </Grid.ColumnDefinitions>
      <Grid RowDefinitions="Auto,10,Auto,10,Auto,10,*">
        <Grid ColumnDefinitions="*,8,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:JournalButton Label="Новая заявка" Icon="plus" Classes="primary" Command="{Binding NewOrderCommand}" Click="OnFocusNewOrder" />
            <ui:JournalButton x:Name="OpenWorkflowTrash" Label="{Binding TrashCaption}" Click="OnTrash" />
          </StackPanel>
          <ui:JournalButton Grid.Column="2" Icon="refresh-cw" IconOnly="True" Width="36" Command="{Binding ReloadCommand}" ToolTip.Tip="Обновить заявки · F5" AutomationProperties.Name="Обновить заявки" />
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
          <RadioButton x:Name="WorkflowToday" Classes="filter" Content="Сегодня" GroupName="WorkflowPeriod"
                       IsChecked="{Binding IsTodaySelected, Mode=TwoWay}" Command="{Binding TodayCommand}" />
          <vm:WorkflowDatePicker x:Name="WorkflowPeriodPicker" SelectedDate="{Binding FilterDate, Mode=TwoWay}" Width="142" />
          <RadioButton x:Name="WorkflowAllDates" Classes="filter" Content="Все даты" GroupName="WorkflowPeriod"
                       IsChecked="{Binding IsAllDatesSelected, Mode=TwoWay}" Command="{Binding AllDatesCommand}" />
        </StackPanel>
        <TextBox x:Name="WorkflowSearchInput" Grid.Row="4" Text="{Binding Search, Mode=TwoWay}"
                 PlaceholderText="Поиск по заявкам" KeyDown="OnSearchKeyDown" AutomationProperties.Name="Поиск заявок и спецификаций"
                 ToolTip.Tip="По части номера, спецификации, заказчика, менеджера, БЛЦБ, проекта или материала. Несколько слов уточняют поиск.">
          <TextBox.InnerLeftContent>
            <Path Data="M10,3 A7,7 0 1 0 10,17 A7,7 0 1 0 10,3 M15,15 L21,21" Width="16" Height="16"
                  Stretch="Uniform" Stroke="{DynamicResource JournalMuted}" StrokeThickness="2" Margin="10,0,2,0" IsHitTestVisible="False" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <Grid Width="32">
              <ui:JournalButton x:Name="ClearWorkflowSearch" Classes="search-clear" Icon="x" IconOnly="True" Label="Очистить поиск"
                                Width="28" Height="28" MinHeight="28" Padding="0" Margin="0,0,4,0"
                                IsVisible="{Binding HasSearchText}" Click="OnClearSearch" ToolTip.Tip="Очистить поиск · Esc" />
            </Grid>
          </TextBox.InnerRightContent>
        </TextBox>
        <Grid Grid.Row="6" RowDefinitions="Auto,*,Auto">
        <TextBlock x:Name="WorkflowSearchSummary" Text="{Binding SearchSummary}" Classes="muted" FontSize="12" Margin="0,0,0,8" />
        <Grid Grid.Row="1">
        <DataGrid RowHeight="NaN" x:Name="WorkflowOrdersGrid" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" AutoGenerateColumns="False" IsReadOnly="True" DoubleTapped="OnOpenOrder" SelectionMode="Single" GridLinesVisibility="None">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Заявка" Width="112" SortMemberPath="Number"><DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:WorkflowOrderRow">
                <Grid ColumnDefinitions="6,8,*" Margin="0,8,4,8" ToolTip.Tip="{Binding NumberHint}"
                      AutomationProperties.Name="{Binding NumberCaption}" AutomationProperties.HelpText="{Binding CreatorDescription}">
                  <Border x:Name="WorkflowCreatorMarker" Width="6" MinHeight="26" CornerRadius="2" Background="{Binding CreatorBrush}"
                          BorderBrush="{DynamicResource JournalBorder}" BorderThickness="1" IsHitTestVisible="False" />
                  <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NumberDate}" FontSize="12" TextTrimming="None" />
                    <TextBlock Text="{Binding NumberTime}" Classes="muted" FontSize="12" TextWrapping="Wrap" TextTrimming="None" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Заказчик" Width="*" MinWidth="130">
              <DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="vm:WorkflowOrderRow">
                <StackPanel Spacing="4" Margin="4,10,8,10">
                  <TextBlock Text="{Binding Customer}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Details}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Updated}" Classes="muted" FontSize="12" />
                  <TextBlock Text="{Binding SearchDetail}" IsVisible="{Binding HasSearchDetail}" Classes="muted" FontSize="12"
                             MaxLines="1" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SearchDetail}" />
                </StackPanel>
              </DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Резка, ₽" Binding="{Binding Total}" Width="110" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="WorkflowEmptyPeriod" Text="{Binding EmptyOrderListText}" IsVisible="{Binding IsOrderListEmpty}"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,64,12,12" TextWrapping="Wrap"
                   Foreground="{DynamicResource JournalMuted}" IsHitTestVisible="False" />
        </Grid>
        <ui:JournalButton x:Name="LoadMoreWorkflowOrders" Grid.Row="2" Label="Показать ещё" Command="{Binding LoadMoreOrdersCommand}" IsVisible="{Binding HasMoreOrders}" IsEnabled="{Binding CanUse}" Margin="0,8,0,0" />
        </Grid>
      </Grid>
      <GridSplitter x:Name="JournalPaneSplitter" Classes="workflow-splitter columns" Grid.Column="1" Width="6" HorizontalAlignment="Center" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                    KeyboardIncrement="16" ToolTip.Tip="Ширина журнала и карточки · ← →" AutomationProperties.Name="Ширина журнала и карточки заявки" />
      <Grid Grid.Column="2">
        <TextBlock Text="Выберите заявку слева или создайте новую" IsVisible="{Binding IsNoCardSelected}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Border x:Name="WorkflowNewOrderForm" IsVisible="{Binding IsCreating}" Classes="panel" Padding="20" Width="600" HorizontalAlignment="Left" VerticalAlignment="Top">
          <StackPanel Spacing="16">
            <TextBlock Text="Новая заявка" FontSize="22" FontWeight="SemiBold" />
            <StackPanel Spacing="4"><TextBlock Text="Менеджер" Classes="muted" />
              <ui:EntrySuggestionComboBox x:Name="NewManagerInput" Value="{Binding NewManager}" Suggestions="{Binding ManagerSuggestions}" Width="320" HorizontalAlignment="Left" AutomationProperties.Name="Менеджер новой заявки" />
            </StackPanel>
            <StackPanel Spacing="4"><TextBlock Text="Заказчик" Classes="muted" />
              <ui:EntrySuggestionComboBox x:Name="NewCustomerInput" Value="{Binding NewCustomer}" Suggestions="{Binding CustomerSuggestions}" HorizontalAlignment="Stretch" AutomationProperties.Name="Заказчик новой заявки" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <ui:JournalButton Label="Создать" Classes="primary" Click="OnCreateOrder" /><ui:JournalButton Label="Отмена" Command="{Binding CancelNewOrderCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      <Grid x:Name="WorkflowOrderCard" IsVisible="{Binding IsCardVisible}" RowDefinitions="Auto,12,Auto,12,*,12,Auto">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,8,Auto">
            <TextBlock x:Name="WorkflowOrderTitle" Text="{Binding OrderTitle}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OrderTitle}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCurrentOrderActive}">
              <ui:JournalButton x:Name="MoveWorkflowOrderToTrash" Label="В корзину…" Icon="trash" Click="OnMoveToTrash" />
              <Button x:Name="WorkflowOrderActions" Classes="command" Width="32" Height="32" Padding="0" VerticalAlignment="Center"
                      IsEnabled="{Binding CanUse}" ToolTip.Tip="Действия с заявкой" AutomationProperties.Name="Действия с заявкой">
                <TextBlock Text="⋯" FontSize="20" />
                <Button.Flyout>
                  <MenuFlyout><MenuItem Header="Сменить ответственного…" Click="OnChangeResponsible" /></MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </Grid>
          <Border x:Name="WorkflowCardReview" Classes="panel" Padding="12" IsVisible="{Binding HasCardReview}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding CardReviewText}" TextWrapping="Wrap" />
              <WrapPanel>
                <ui:JournalButton Label="Открыть корзину" Click="OnTrash" Margin="0,0,8,0" />
                <ui:JournalButton x:Name="DiscardWorkflowCardChanges" Label="Отменить правки и обновить" Command="{Binding DiscardCardChangesCommand}" IsVisible="{Binding IsCurrentCardStale}" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        <Expander x:Name="OrderHeaderExpander" Grid.Row="2" HorizontalAlignment="Stretch" Background="{DynamicResource JournalSurface}" Header="{Binding HeaderSummary}" IsEnabled="{Binding IsCurrentOrderActive}">
          <Border Classes="panel" Padding="12">
            <Grid RowDefinitions="Auto,4,Auto">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="320" /><ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MaxWidth="320" /><ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Менеджер" Classes="muted" /><TextBlock Grid.Column="2" Text="БЛЦБ" Classes="muted" />
              <ui:EntrySuggestionComboBox x:Name="WorkflowManagerInput" Grid.Row="2" Value="{Binding ManagerName}" Suggestions="{Binding ManagerSuggestions}" HorizontalAlignment="Stretch" AutomationProperties.Name="Менеджер заявки" />
              <TextBox x:Name="WorkflowBlcbInput" Grid.Row="2" Grid.Column="2" Text="{Binding Blcb, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Номер БЛЦБ" />
              <ui:JournalButton x:Name="SaveWorkflowHeader" Grid.Row="2" Grid.Column="4" Label="Сохранить" Command="{Binding SaveHeaderCommand}" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Expander>
        <TabControl x:Name="WorkflowOrderTabs" Grid.Row="4" SelectedIndex="{Binding OrderTabIndex, Mode=TwoWay}" IsEnabled="{Binding IsCurrentOrderActive}">
          <TabItem Header="Проекты">
            <Grid RowDefinitions="Auto,8,Auto,8,*" Margin="0,8,0,0">
              <WrapPanel>
                <ui:JournalButton x:Name="PrepareWorkflowProject" Label="Добавить проект" Icon="plus" Command="{Binding AddProjectCommand}" Click="OnFocusProject" Margin="0,0,8,4" />
                <ui:JournalButton x:Name="RefreshWorkflowReports" Label="Загрузить спецификации" Icon="refresh-cw" Click="OnRefreshReports" Classes="primary" Margin="0,0,8,4" />
                <CheckBox x:Name="WorkflowProjectTrashToggle" Content="{Binding ProjectTrashCaption}" IsChecked="{Binding ShowTrashedProjects, Mode=TwoWay}" Margin="4,0,0,4" VerticalAlignment="Center" />
                <ui:JournalButton Label="Выбрать папку хранения…" Click="OnSettings" IsVisible="{Binding NeedsProjectRoot}" Margin="8,0,0,4" />
              </WrapPanel>
              <Border Grid.Row="2" Classes="panel" Padding="12" IsVisible="{Binding IsPlanning}">
                <Grid RowDefinitions="Auto,8,Auto,4,Auto" ColumnDefinitions="*,12,140,12,Auto,8,Auto">
                  <Grid Grid.ColumnSpan="7" ColumnDefinitions="Auto,12,*">
                    <TextBlock Text="{Binding PlanTitle}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="{Binding PlannedName}" Classes="muted" TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <TextBlock Grid.Row="2" Text="Станок" Classes="muted" /><TextBlock Grid.Row="2" Grid.Column="2" Text="Толщина, мм" Classes="muted" />
                  <ComboBox x:Name="WorkflowProjectMachine" Grid.Row="4" ItemsSource="{Binding ProjectMachines}" SelectedItem="{Binding PlanMachine}" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEditPlan}" AutomationProperties.Name="Станок проекта">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="core:WorkflowMachine"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <ui:EntrySuggestionComboBox x:Name="WorkflowProjectThickness" Grid.Row="4" Grid.Column="2" Value="{Binding PlanThickness}" Suggestions="{Binding PlanThicknessSuggestions}" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEditPlan}" AutomationProperties.Name="Толщина проекта, мм" />
                  <ui:JournalButton Grid.Row="4" Grid.Column="4" Label="Создать проект" Classes="primary" Command="{Binding CreateProjectCommand}" />
                  <ui:JournalButton Grid.Row="4" Grid.Column="6" Label="Отмена" Command="{Binding CancelPlanningCommand}" />
                </Grid>
              </Border>
              <Grid x:Name="WorkflowProjectWorkspace" Grid.Row="4">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" MinHeight="150" /><RowDefinition Height="Auto" />
                  <RowDefinition Height="1.5*" MaxHeight="{Binding CalculationMaxHeight}" />
                </Grid.RowDefinitions>
                <Grid>
              <DataGrid RowHeight="NaN" x:Name="WorkflowProjectsGrid" Grid.Row="0" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" AutoGenerateColumns="False" IsReadOnly="True" HorizontalScrollBarVisibility="Disabled">
                <DataGrid.RowTheme>
                  <ControlTheme TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}" x:DataType="vm:WorkflowProjectRow">
                    <Setter Property="vm:WorkflowProjectRowAppearance.IsExcluded" Value="{Binding IsExcluded}" />
                  </ControlTheme>
                </DataGrid.RowTheme>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Учитывать" Width="80" CanUserSort="False"><DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:WorkflowProjectRow">
                      <CheckBox IsChecked="{Binding DisplayedIncluded, Mode=OneWay}" IsEnabled="{Binding CanToggle}" IsHitTestVisible="{Binding CanHitToggle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                ToolTip.Tip="{Binding InclusionHint}" AutomationProperties.Name="{Binding InclusionHint}" Click="OnProjectIncluded" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Позиция" Width="108" SortMemberPath="Position"><DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:WorkflowProjectRow">
                      <TextBlock Text="{Binding Position}" Classes="workflowProjectInfo" Classes.excluded="{Binding IsExcluded}"
                                 Margin="4,8" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Проект" Width="*" MinWidth="210"><DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:WorkflowProjectRow">
                      <Grid>
                        <StackPanel Spacing="3" Margin="4,6" IsVisible="{Binding !IsExcluded}">
                          <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxLines="0" TextTrimming="None" Classes="workflowProjectInfo projectName" Classes.excluded="{Binding IsExcluded}" ToolTip.Tip="{Binding Name}" />
                          <WrapPanel>
                            <TextBlock Text="{Binding Material}" Classes="workflowProjectInfo projectMaterial" Classes.excluded="{Binding IsExcluded}" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding State}" Classes="workflowProjectInfo" Classes.excluded="{Binding IsExcluded}" FontSize="12" />
                          </WrapPanel>
                        </StackPanel>
                        <Grid x:Name="WorkflowCompactProject" ColumnDefinitions="*,8,Auto" Margin="4,0" VerticalAlignment="Center"
                              IsVisible="{Binding IsExcluded}" ToolTip.Tip="{Binding DetailsHint}" AutomationProperties.Name="{Binding DetailsHint}">
                          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center"
                                     Classes="workflowProjectInfo projectName" Classes.excluded="{Binding IsExcluded}" />
                          <TextBlock Grid.Column="2" Text="Исключён" FontSize="11" VerticalAlignment="Center"
                                     Classes="workflowProjectInfo" Classes.excluded="{Binding IsExcluded}" />
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Фаска" Width="60" IsReadOnly="True" CanUserSort="False" CanUserResize="False"><DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:WorkflowProjectRow">
                      <TextBlock Text="{Binding ChamferMark}" Classes="workflowProjectInfo projectChamfer" Classes.excluded="{Binding IsExcluded}"
                                 FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{Binding ChamferHint}" AutomationProperties.Name="{Binding ChamferHint}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Гибка" Width="60" IsReadOnly="True" CanUserSort="False" CanUserResize="False"><DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:WorkflowProjectRow">
                      <TextBlock Text="{Binding BendingMark}" Classes="workflowProjectInfo projectBending" Classes.excluded="{Binding IsExcluded}"
                                 FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{Binding BendingHint}" AutomationProperties.Name="{Binding BendingHint}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Резка" Width="112" SortMemberPath="Total"><DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:WorkflowProjectRow">
                      <TextBlock Text="{Binding Total}" Classes="workflowProjectInfo" Classes.excluded="{Binding IsExcluded}"
                                 Margin="4,8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Total}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="" Width="48" CanUserSort="False" CanUserResize="False"><DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:WorkflowProjectRow">
                      <Button Classes="command" Width="36" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsEnabled="{Binding HasFolder}" ToolTip.Tip="{Binding FolderHint}" AutomationProperties.Name="Открыть папку проекта" Click="OnOpenFolder">
                        <PathIcon Width="18" Height="18" Data="{StaticResource WorkflowFolderIcon}" />
                      </Button>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="" Width="40" CanUserSort="False" CanUserResize="False"><DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:WorkflowProjectRow">
                      <Button Classes="command" Width="32" Height="32" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                              ToolTip.Tip="Действия с проектом" AutomationProperties.Name="Действия с проектом" IsVisible="{Binding HasProjectActions}">
                        <TextBlock Text="⋮" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button.Flyout>
                          <MenuFlyout>
                            <MenuItem Header="{Binding EditCaption}" IsEnabled="{Binding CanEdit}" IsVisible="{Binding IsActive}" Click="OnEditProject" />
                            <MenuItem Header="Создать другой вариант…" IsVisible="{Binding IsActive}" IsEnabled="{Binding CanTrash}" Click="OnRedoProject" />
                            <MenuItem Header="Использовать в итоге" IsVisible="{Binding CanChooseForTotal}" Click="OnSelectProjectForTotal" />
                            <MenuItem Header="Убрать в корзину…" IsVisible="{Binding IsActive}" IsEnabled="{Binding CanTrash}" Click="OnTrashProject" />
                            <MenuItem Header="Восстановить проект" IsVisible="{Binding IsDeleted}" Click="OnRestoreProject" />
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
                  <TextBlock Text="{Binding EmptyProjectText}" IsVisible="{Binding IsProjectListEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Classes="muted" TextWrapping="Wrap" MaxWidth="600" TextAlignment="Center" IsHitTestVisible="False" />
                </Grid>
                <GridSplitter x:Name="WorkflowCalculationSplitter" Classes="workflow-splitter rows" Grid.Row="1" Height="6" Margin="0,4" HorizontalAlignment="Stretch"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              IsVisible="{Binding ShowProjectCalculation}" AutomationProperties.Name="Размер списка проектов и расчёта" />
                <Border x:Name="WorkflowProjectCalculation" Grid.Row="2" Classes="panel" Padding="12" IsVisible="{Binding ShowProjectCalculation}">
                  <Grid>
                  <TextBlock Text="{Binding CalculationEmptyText}" IsVisible="{Binding !HasSelectedDraft}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Grid RowDefinitions="Auto,8,*,8,Auto" IsVisible="{Binding HasSelectedDraft}">
                    <Grid ColumnDefinitions="Auto,12,*,12,Auto">
                      <TextBlock Text="Расчёт" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" DataContext="{Binding SelectedDraft}" x:DataType="vm:SpecificationDraft" Text="{Binding ProjectSummary}"
                                 FontSize="12" Classes="muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ProjectSummary}" VerticalAlignment="Center" />
                      <ui:JournalButton x:Name="OpenAcceptedWorkflowReport" Grid.Column="4" Label="Открыть спецификацию" Click="OnOpenAcceptedReport"
                                        IsEnabled="{Binding HasAcceptedReport}" VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer x:Name="WorkflowCalculationFields" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                      <StackPanel Spacing="8" DataContext="{Binding SelectedDraft}" x:DataType="vm:SpecificationDraft">
                        <TextBlock Text="{Binding ImportNotice}" IsVisible="{Binding HasImportNotice}" TextWrapping="Wrap" Foreground="{DynamicResource JournalDangerForeground}" />
                        <Grid ColumnDefinitions="*,12,*,12,*" RowDefinitions="Auto,4,Auto">
                          <TextBlock Text="Материал" Classes="muted" /><TextBlock Grid.Column="2" Text="Длина реза, м" Classes="muted" /><TextBlock Grid.Column="4" Text="Пробивки, шт." Classes="muted" />
                          <TextBox x:Name="WorkflowCalculationMaterial" Grid.Row="2" Text="{Binding Material}" AutomationProperties.Name="Материал расчёта" />
                          <TextBox x:Name="WorkflowCalculationLength" Grid.Row="2" Grid.Column="2" Text="{Binding Length}" AutomationProperties.Name="Длина реза, м" />
                          <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding Pierces}" AutomationProperties.Name="Пробивки, шт." />
                        </Grid>
                        <CheckBox Content="Материал проверен" IsVisible="{Binding MaterialNeedsReview}" IsChecked="{Binding MaterialConfirmed}" />
                          <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,12,*,12,*" RowDefinitions="Auto,4,Auto,8,Auto,4,Auto">
                              <TextBlock Text="Заготовка" Classes="muted" /><TextBlock Grid.Column="2" Text="Количество, шт." Classes="muted" /><TextBlock Grid.Column="4" Text="Вес, кг" Classes="muted" />
                              <TextBox Grid.Row="2" Text="{Binding BlankSize}" /><TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Quantity}" /><TextBox Grid.Row="2" Grid.Column="4" Text="{Binding Weight}" />
                              <TextBlock Grid.Row="4" Text="Время резки" Classes="muted" /><TextBlock Grid.Row="4" Grid.Column="4" Text="Категория тарифа" Classes="muted" IsVisible="{Binding UsesMaterialCategories}" />
                              <TextBox Grid.Row="6" Text="{Binding Duration}" />
                              <WrapPanel Grid.Row="6" Grid.Column="2">
                                <CheckBox x:Name="WorkflowHasChamfer" Content="Фаска" IsChecked="{Binding HasChamfer}" Margin="0,0,12,0" />
                                <CheckBox Content="Гибка" IsChecked="{Binding HasBending}" />
                              </WrapPanel>
                              <ui:EntrySuggestionComboBox Grid.Row="6" Grid.Column="4" Value="{Binding MaterialGroup}" Suggestions="{Binding MaterialGroupSuggestions}"
                                                          HorizontalAlignment="Stretch" IsVisible="{Binding UsesMaterialCategories}" />
                            </Grid>
                            <TextBox Text="{Binding Comment}" PlaceholderText="Комментарий" AutomationProperties.Name="Комментарий к расчёту"
                                     AcceptsReturn="True" TextWrapping="Wrap" MaxLength="255" MinHeight="32" MaxHeight="64" />
                            <Grid ColumnDefinitions="*,8,Auto">
                              <TextBlock Text="{Binding RateSummary}" Classes="muted" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Breakdown}" />
                              <ui:JournalButton x:Name="RefreshWorkflowCalculationPrices" Grid.Column="2" Label="Обновить цены" Click="OnRefreshCalculationPrices" />
                            </Grid>
                          </StackPanel>
                      </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="4" ColumnDefinitions="*,8,Auto,6,88,12,Auto,8,Auto" RowDefinitions="Auto,Auto">
                      <TextBlock Grid.ColumnSpan="9" DataContext="{Binding SelectedDraft}" x:DataType="vm:SpecificationDraft" Text="{Binding CalculationError}"
                                 TextWrapping="Wrap" Foreground="{DynamicResource JournalDangerForeground}" />
                      <TextBlock Grid.Row="1" DataContext="{Binding SelectedDraft}" x:DataType="vm:SpecificationDraft" Text="{Binding TotalText}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip.Tip="{Binding Breakdown}" />
                      <TextBlock Grid.Row="1" Grid.Column="2" Text="Коэффициент" Classes="muted" VerticalAlignment="Center" />
                      <TextBox x:Name="WorkflowCalculationCoefficient" Grid.Row="1" Grid.Column="4" DataContext="{Binding SelectedDraft}" x:DataType="vm:SpecificationDraft"
                               Text="{Binding Coefficient}" AutomationProperties.Name="Ручной коэффициент спецификации" />
                      <ui:JournalButton x:Name="SaveWorkflowSpecification" Grid.Row="1" Grid.Column="6" Label="Сохранить" Classes="primary" Command="{Binding SaveSpecificationCommand}" />
                      <ui:JournalButton Grid.Row="1" Grid.Column="8" Label="Отменить" Command="{Binding CancelDraftCommand}" />
                    </Grid>
                  </Grid>
                  </Grid>
                </Border>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem Header="Письмо">
            <TextBox Text="{Binding ResultText}" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Margin="0,8,0,0" VerticalAlignment="Stretch" AutomationProperties.Name="Результат для письма" />
          </TabItem>
        </TabControl>
        <Border Grid.Row="6" Classes="panel" Padding="12">
          <Grid ColumnDefinitions="*,12,Auto,8,Auto" RowDefinitions="Auto,Auto">
            <StackPanel Spacing="2"><TextBlock Text="{Binding TotalText}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding ProjectsStatus}" Classes="muted" TextWrapping="Wrap" ToolTip.Tip="{Binding BendingText}" />
              <TextBlock Text="Данные изменились — сформируйте результат заново" TextWrapping="Wrap" IsVisible="{Binding ResultIsStale}" Foreground="{DynamicResource JournalDangerForeground}" />
            </StackPanel>
            <ui:JournalButton Grid.Column="2" Label="Результат" Command="{Binding GenerateResultCommand}" /><ui:JournalButton Grid.Column="4" Icon="copy" IconOnly="True" Width="36" Click="OnCopyResult" ToolTip.Tip="Копировать результат" AutomationProperties.Name="Копировать результат" />
          </Grid>
        </Border>
      </Grid>
      </Grid>
    </Grid>
    <ProgressBar Grid.Row="3" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" />
    <TextBlock Grid.Row="4" Margin="20,0" Text="{Binding PriceSourceDescription}" Classes="muted" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="Тарифы загружаются вручную через Станки и цены → Импорт цен из прежней БД. Заявки нового журнала хранятся отдельно." />
  </Grid>
</Window>
