<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Jornal.Workflow.Desktop" xmlns:core="using:Jornal.Workflow.Core" xmlns:ui="using:Jornal.Desktop.Controls"
        x:Class="Jornal.Workflow.Desktop.WorkflowWindow" x:DataType="vm:WorkflowViewModel"
        Title="{x:Static vm:WorkflowIdentity.WindowTitle}" Width="1480" Height="900" MinWidth="1180" MinHeight="720"
        Background="{DynamicResource JournalBackground}" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <StreamGeometry x:Key="WorkflowFolderIcon">M3,4 H9 L11,6 H21 V9 H7 L3,18 Z M7,11 H23 L19,20 H3 Z</StreamGeometry>
  </Window.Resources>
  <Grid RowDefinitions="56,Auto,*,4,28">
    <Border Background="{DynamicResource JournalSurface}" BorderBrush="{DynamicResource JournalBorder}" BorderThickness="0,0,0,1" Padding="20,8">
      <Grid ColumnDefinitions="*,Auto,*">
        <StackPanel Spacing="1" VerticalAlignment="Center">
          <TextBlock Text="{x:Static vm:WorkflowIdentity.Name}" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="Локальная разработка" Classes="muted" FontSize="11" />
        </StackPanel>
        <ui:HeaderClock x:Name="WorkflowHeaderClock" Grid.Column="1" MinWidth="200" Margin="12,0" FontFeatures="tnum" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
        <Grid Grid.Column="2" ColumnDefinitions="Auto,8,Auto,8,Auto,8,Auto,8,Auto" HorizontalAlignment="Right">
          <ui:JournalButton x:Name="WorkflowCatalog" Label="Станки и цены" Click="OnCatalog" IsEnabled="{Binding CanUse}" />
          <Border x:Name="WorkflowProfileBadge" Grid.Column="2" Width="130" Padding="9,6" CornerRadius="6" VerticalAlignment="Center"
                  Background="{DynamicResource JournalBackground}" BorderBrush="{DynamicResource JournalBorder}" BorderThickness="1"
                  ToolTip.Tip="{Binding ProfileHint}" AutomationProperties.Name="{Binding ProfileName}">
            <Grid ColumnDefinitions="12,7,*">
              <Border Width="10" Height="10" CornerRadius="5" Background="{Binding ProfileBrush}" BorderBrush="{DynamicResource JournalBorder}" BorderThickness="1" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding ProfileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ToggleButton x:Name="ThemeSwitch" Grid.Column="4" Theme="{StaticResource JournalThemeSwitch}" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}" IsCheckedChanged="OnThemeChanged" VerticalAlignment="Center" ToolTip.Tip="Светлая / тёмная тема" />
          <ui:JournalButton x:Name="WorkflowSettings" Grid.Column="6" Icon="settings" IconOnly="True" Width="40" Height="36" Click="OnSettings" ToolTip.Tip="Настройки" IsEnabled="{Binding CanUse}" AutomationProperties.Name="Настройки" />
          <Grid Grid.Column="8">
            <ui:JournalButton x:Name="UpdatesBell" Icon="bell" IconOnly="True" Width="40" Height="36" Click="OnUpdates" ToolTip.Tip="{x:Static vm:WorkflowIdentity.UpdatesTitle}" />
            <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource JournalAccent}" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding Updates.HasUpdate}" IsHitTestVisible="False" />
          </Grid>
        </Grid>
      </Grid>
    </Border>
    <TextBlock Grid.Row="1" Text="{Binding Error}" TextWrapping="Wrap" Margin="20,8,20,0" Foreground="{DynamicResource JournalDangerForeground}" />
    <Grid x:Name="JournalWorkspace" Grid.Row="2" Margin="20,12" IsEnabled="{Binding CanUse}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="4*" MinWidth="368" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="6*" MinWidth="760" />
      </Grid.ColumnDefinitions>
      <Grid RowDefinitions="Auto,10,Auto,10,*">
        <Grid ColumnDefinitions="*,8,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:JournalButton Label="Новая заявка" Icon="plus" Classes="primary" Command="{Binding NewOrderCommand}" Click="OnFocusNewOrder" />
            <ui:JournalButton x:Name="OpenWorkflowTrash" Label="{Binding TrashCaption}" Click="OnTrash" />
          </StackPanel>
          <ui:JournalButton Grid.Column="2" Icon="refresh-cw" IconOnly="True" Width="36" Command="{Binding ReloadCommand}" ToolTip.Tip="Обновить заявки · F5" AutomationProperties.Name="Обновить заявки" />
        </Grid>
        <TextBox Grid.Row="2" Text="{Binding Search, Mode=TwoWay}" PlaceholderText="Поиск заявок и спецификаций" />
        <DataGrid RowHeight="NaN" x:Name="WorkflowOrdersGrid" Grid.Row="4" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" AutoGenerateColumns="False" IsReadOnly="True" DoubleTapped="OnOpenOrder" SelectionMode="Single" GridLinesVisibility="None">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Заявка" Width="112" SortMemberPath="Number"><DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="vm:WorkflowOrderRow">
                <Grid ColumnDefinitions="6,8,*" Margin="0,8,4,8" ToolTip.Tip="{Binding NumberHint}"
                      AutomationProperties.Name="{Binding NumberCaption}" AutomationProperties.HelpText="{Binding CreatorDescription}">
                  <Border x:Name="WorkflowCreatorMarker" Width="6" MinHeight="26" CornerRadius="2" Background="{Binding CreatorBrush}"
                          BorderBrush="{DynamicResource JournalBorder}" BorderThickness="1" IsHitTestVisible="False" />
                  <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NumberDate}" FontSize="12" TextTrimming="None" />
                    <TextBlock Text="{Binding NumberTime}" Classes="muted" FontSize="12" TextWrapping="Wrap" TextTrimming="None" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Заказчик" Width="*" MinWidth="130">
              <DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="vm:WorkflowOrderRow">
                <StackPanel Spacing="4" Margin="4,10,8,10">
                  <TextBlock Text="{Binding Customer}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Details}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Updated}" Classes="muted" FontSize="12" />
                </StackPanel>
              </DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Резка, ₽" Binding="{Binding Total}" Width="110" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
      <GridSplitter x:Name="JournalPaneSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Center" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                    KeyboardIncrement="16" Background="{DynamicResource JournalBorder}" ToolTip.Tip="Ширина журнала и карточки · ← →" AutomationProperties.Name="Ширина журнала и карточки заявки" />
      <Grid Grid.Column="2">
        <TextBlock Text="Выберите заявку слева или создайте новую" IsVisible="{Binding IsNoCardSelected}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Border x:Name="WorkflowNewOrderForm" IsVisible="{Binding IsCreating}" Classes="panel" Padding="20" Width="600" HorizontalAlignment="Left" VerticalAlignment="Top">
          <StackPanel Spacing="16">
            <TextBlock Text="Новая заявка" FontSize="22" FontWeight="SemiBold" />
            <StackPanel Spacing="4"><TextBlock Text="Менеджер" Classes="muted" />
              <ui:EntrySuggestionComboBox x:Name="NewManagerInput" Value="{Binding NewManager}" Suggestions="{Binding ManagerSuggestions}" Width="320" HorizontalAlignment="Left" AutomationProperties.Name="Менеджер новой заявки" />
            </StackPanel>
            <StackPanel Spacing="4"><TextBlock Text="Заказчик" Classes="muted" />
              <ui:EntrySuggestionComboBox x:Name="NewCustomerInput" Value="{Binding NewCustomer}" Suggestions="{Binding CustomerSuggestions}" HorizontalAlignment="Stretch" AutomationProperties.Name="Заказчик новой заявки" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <ui:JournalButton Label="Создать" Classes="primary" Click="OnCreateOrder" /><ui:JournalButton Label="Отмена" Command="{Binding CancelNewOrderCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      <Grid x:Name="WorkflowOrderCard" IsVisible="{Binding IsCardVisible}" RowDefinitions="Auto,12,Auto,12,*,12,Auto">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,8,Auto">
            <TextBlock x:Name="WorkflowOrderTitle" Text="{Binding OrderTitle}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding OrderTitle}" />
            <ui:JournalButton x:Name="MoveWorkflowOrderToTrash" Grid.Column="2" Label="В корзину…" Icon="trash" Click="OnMoveToTrash" IsVisible="{Binding IsCurrentOrderActive}" />
          </Grid>
          <Border x:Name="WorkflowCardReview" Classes="panel" Padding="12" IsVisible="{Binding HasCardReview}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding CardReviewText}" TextWrapping="Wrap" />
              <WrapPanel>
                <ui:JournalButton Label="Открыть корзину" Click="OnTrash" Margin="0,0,8,0" />
                <ui:JournalButton x:Name="DiscardWorkflowCardChanges" Label="Отменить правки и обновить" Command="{Binding DiscardCardChangesCommand}" IsVisible="{Binding IsCurrentCardStale}" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        <Expander x:Name="OrderHeaderExpander" Grid.Row="2" HorizontalAlignment="Stretch" Background="{DynamicResource JournalSurface}" Header="{Binding HeaderSummary}" IsEnabled="{Binding IsCurrentOrderActive}">
          <Border Classes="panel" Padding="12">
            <Grid ColumnDefinitions="*,12,*,12,100" RowDefinitions="Auto,4,Auto,12,Auto,4,Auto">
              <TextBlock Text="Менеджер" Classes="muted" /><TextBlock Grid.Column="2" Grid.ColumnSpan="3" Text="Ответственный технолог" Classes="muted" />
              <ComboBox Grid.Row="2" ItemsSource="{Binding Employees}" SelectedItem="{Binding Manager}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="core:Employee"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <ComboBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" ItemsSource="{Binding Employees}" SelectedItem="{Binding Technologist}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="core:Employee"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <TextBlock Grid.Row="4" Text="БЛЦБ" Classes="muted" /><TextBlock Grid.Row="4" Grid.Column="4" Text="Год" Classes="muted" />
              <TextBox Grid.Row="6" Text="{Binding Blcb}" /><TextBox Grid.Row="6" Grid.Column="4" Text="{Binding BlcbYear}" />
              <ui:JournalButton Grid.Row="6" Grid.Column="2" Label="Сохранить реквизиты" Command="{Binding SaveHeaderCommand}" HorizontalAlignment="Right" />
            </Grid>
          </Border>
        </Expander>
        <TabControl x:Name="WorkflowOrderTabs" Grid.Row="4" SelectedIndex="{Binding OrderTabIndex, Mode=TwoWay}" IsEnabled="{Binding IsCurrentOrderActive}">
          <TabItem Header="Проекты">
            <Grid RowDefinitions="Auto,8,Auto,8,*,8,Auto" Margin="0,8,0,0">
              <WrapPanel>
                <ui:JournalButton x:Name="PrepareWorkflowProject" Label="Подготовить проект" Icon="plus" Command="{Binding AddProjectCommand}" Click="OnFocusProject" Margin="0,0,8,4" />
                <ui:JournalButton x:Name="RefreshWorkflowReports" Label="Обновить спецификации" Icon="refresh-cw" Click="OnRefreshReports" Classes="primary" Margin="0,0,8,4" />
                <ui:JournalButton Label="Выбрать папку хранения…" Click="OnSettings" IsVisible="{Binding NeedsProjectRoot}" Margin="8,0,0,4" />
              </WrapPanel>
              <Border Grid.Row="2" Classes="panel" Padding="12" IsVisible="{Binding IsPlanning}">
                <Grid RowDefinitions="Auto,8,Auto,4,Auto" ColumnDefinitions="*,12,140,12,Auto,8,Auto">
                  <Grid Grid.ColumnSpan="7" ColumnDefinitions="Auto,12,*">
                    <TextBlock Text="{Binding PlanTitle}" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="{Binding PlannedName}" Classes="muted" TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <TextBlock Grid.Row="2" Text="Станок" Classes="muted" /><TextBlock Grid.Row="2" Grid.Column="2" Text="Толщина, мм" Classes="muted" />
                  <ComboBox x:Name="WorkflowProjectMachine" Grid.Row="4" ItemsSource="{Binding ProjectMachines}" SelectedItem="{Binding PlanMachine}" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEditPlan}" AutomationProperties.Name="Станок проекта">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="core:WorkflowMachine"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <ui:EntrySuggestionComboBox x:Name="WorkflowProjectThickness" Grid.Row="4" Grid.Column="2" Value="{Binding PlanThickness}" Suggestions="{Binding PlanThicknessSuggestions}" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEditPlan}" AutomationProperties.Name="Толщина проекта, мм" />
                  <ui:JournalButton Grid.Row="4" Grid.Column="4" Label="Создать заготовку проекта" Classes="primary" Command="{Binding CreateProjectCommand}" />
                  <ui:JournalButton Grid.Row="4" Grid.Column="6" Label="Отмена" Command="{Binding CancelPlanningCommand}" />
                </Grid>
              </Border>
              <DataGrid RowHeight="NaN" x:Name="WorkflowProjectsGrid" Grid.Row="4" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" AutoGenerateColumns="False" IsReadOnly="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Позиция" Binding="{Binding Position}" Width="120" />
                  <DataGridTemplateColumn Header="Проект" Width="*" MinWidth="210"><DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:WorkflowProjectRow"><StackPanel Spacing="4" Margin="4,8">
                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" ToolTip.Tip="{Binding Name}" />
                      <TextBlock Text="{Binding Material}" Classes="muted" /><TextBlock Text="{Binding State}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="Резка" Binding="{Binding Total}" Width="125" />
                  <DataGridTemplateColumn Header="" Width="52" CanUserSort="False" CanUserResize="False"><DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:WorkflowProjectRow">
                      <Button Classes="command" Width="36" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsEnabled="{Binding HasFolder}" ToolTip.Tip="{Binding FolderHint}" AutomationProperties.Name="Открыть папку проекта" Click="OnOpenFolder">
                        <PathIcon Width="18" Height="18" Data="{StaticResource WorkflowFolderIcon}" />
                      </Button>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Grid.Row="4" Text="Подготовьте проекты: станок и толщина. Материал и параметры расчёта подтянутся из спецификаций."
                         IsVisible="{Binding IsProjectListEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Classes="muted" TextWrapping="Wrap" MaxWidth="600" TextAlignment="Center" IsHitTestVisible="False" />
              <Grid Grid.Row="6" ColumnDefinitions="*,12,Auto,8,Auto">
                <TextBlock Text="{Binding ProjectsStatus}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
                <ui:JournalButton Grid.Column="2" Label="Другой станок / вариант…" Command="{Binding RedoProjectCommand}" />
                <ui:JournalButton Grid.Column="4" Label="Включить вариант в итог" Command="{Binding SelectProjectForTotalCommand}" />
              </Grid>
            </Grid>
          </TabItem>
          <TabItem Header="Спецификации">
            <Grid RowDefinitions="Auto,8,100,12,*" Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ui:JournalButton Label="Импорт вне проекта…" Icon="plus" Click="OnImportFiles" />
                <ui:JournalButton Label="Ручной ввод" Command="{Binding AddManualSpecificationCommand}" />
              </StackPanel>
              <DataGrid x:Name="WorkflowSpecificationsGrid" Grid.Row="2" ItemsSource="{Binding Drafts}" SelectedItem="{Binding SelectedDraft}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="NaN" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Спецификация" Width="*" MinWidth="150" SortMemberPath="Caption"><DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:SpecificationDraft"><StackPanel Spacing="3" Margin="4,6">
                      <TextBlock Text="{Binding Caption}" FontWeight="SemiBold" /><TextBlock Text="{Binding VersionText}" Classes="muted" FontSize="12" />
                    </StackPanel></DataTemplate>
                  </DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="Станок" Binding="{Binding Machine}" Width="130" />
                  <DataGridTextColumn Header="Материал" Binding="{Binding Material}" Width="120" />
                  <DataGridTextColumn Header="Резка" Binding="{Binding TotalText}" Width="150" />
                  <DataGridTemplateColumn Header="" Width="52" CanUserSort="False" CanUserResize="False"><DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:SpecificationDraft">
                      <Button Classes="command" Width="36" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsEnabled="{Binding HasFolder}" ToolTip.Tip="{Binding FolderHint}" AutomationProperties.Name="Открыть папку спецификации" Click="OnOpenFolder">
                        <PathIcon Width="18" Height="18" Data="{StaticResource WorkflowFolderIcon}" />
                      </Button>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <Grid Grid.Row="4" RowDefinitions="*,8,Auto" IsVisible="{Binding HasSelectedDraft}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Spacing="12">
                    <StackPanel Spacing="12" DataContext="{Binding SelectedDraft}" x:DataType="vm:SpecificationDraft">
                      <TextBlock Text="{Binding ImportNotice}" IsVisible="{Binding HasImportNotice}" TextWrapping="Wrap" Foreground="{DynamicResource JournalDangerForeground}" />
                      <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,4,Auto,12,Auto,4,Auto,12,Auto,4,Auto,12,Auto,4,Auto,12,Auto,4,Auto">
                        <TextBlock Text="Станок" Classes="muted" /><TextBlock Grid.Column="2" Text="Материал" Classes="muted" />
                        <ui:EntrySuggestionComboBox Grid.Row="2" Value="{Binding Machine}" Suggestions="{Binding MachineSuggestions}" HorizontalAlignment="Stretch" /><TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Material}" />
                        <TextBlock Grid.Row="4" Text="Толщина, мм" Classes="muted" /><TextBlock Grid.Row="4" Grid.Column="2" Text="Заготовка" Classes="muted" />
                        <ui:EntrySuggestionComboBox Grid.Row="6" Value="{Binding Thickness}" Suggestions="{Binding ThicknessSuggestions}" HorizontalAlignment="Stretch" /><TextBox Grid.Row="6" Grid.Column="2" Text="{Binding BlankSize}" />
                        <TextBlock Grid.Row="8" Text="Количество, шт." Classes="muted" /><TextBlock Grid.Row="8" Grid.Column="2" Text="Длина реза, м" Classes="muted" />
                        <TextBox Grid.Row="10" Text="{Binding Quantity}" /><TextBox Grid.Row="10" Grid.Column="2" Text="{Binding Length}" />
                        <TextBlock Grid.Row="12" Text="Пробивки, шт." Classes="muted" /><TextBlock Grid.Row="12" Grid.Column="2" Text="Общий вес, кг" Classes="muted" />
                        <TextBox Grid.Row="14" Text="{Binding Pierces}" /><TextBox Grid.Row="14" Grid.Column="2" Text="{Binding Weight}" />
                        <TextBlock Grid.Row="16" Text="Время резки" Classes="muted" />
                        <TextBox Grid.Row="18" Text="{Binding Duration}" /><CheckBox Grid.Row="18" Grid.Column="2" Content="Гибка" IsChecked="{Binding HasBending}" />
                      </Grid>
                      <CheckBox Content="Материал проверен" IsVisible="{Binding MaterialNeedsReview}" IsChecked="{Binding MaterialConfirmed}" />
                      <Expander Header="Номер и дата спецификации" IsExpanded="{Binding IsNew, Mode=OneTime}" HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,4,Auto" Margin="0,8,0,0">
                          <TextBlock Text="Номер спецификации" Classes="muted" /><TextBlock Grid.Column="2" Text="Дата" Classes="muted" />
                          <TextBox Grid.Row="2" Text="{Binding Number}" /><TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Date}" />
                        </Grid>
                      </Expander>
                      <Expander Header="Комментарий" HorizontalAlignment="Stretch">
                        <TextBox Text="{Binding Comment}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="255" MinHeight="60" />
                      </Expander>
                      <TextBlock Text="{Binding SourceName}" Classes="muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SourceName}" />
                    </StackPanel>
                    <Expander Header="Тарифы" HorizontalAlignment="Stretch">
                      <StackPanel Spacing="8" Margin="0,8,0,0">
                        <StackPanel Spacing="8" DataContext="{Binding SelectedDraft}" x:DataType="vm:SpecificationDraft">
                          <TextBlock Text="{Binding Breakdown}" TextWrapping="Wrap" />
                          <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,4,Auto">
                            <TextBlock Text="Цена метра, ₽" Classes="muted" /><TextBlock Grid.Column="2" Text="Цена пробивки, ₽" Classes="muted" />
                            <TextBox Grid.Row="2" Text="{Binding PricePerMeter}" /><TextBox Grid.Row="2" Grid.Column="2" Text="{Binding PricePerPierce}" />
                          </Grid>
                          <StackPanel IsVisible="{Binding UsesMaterialCategories}" Spacing="4">
                            <TextBlock Text="Категория тарифа HansLaser" Classes="muted" />
                            <ui:EntrySuggestionComboBox Value="{Binding MaterialGroup}" Suggestions="{Binding MaterialGroupSuggestions}" HorizontalAlignment="Stretch" />
                          </StackPanel>
                        </StackPanel>
                        <WrapPanel><ui:JournalButton Label="Сохранить тариф" Command="{Binding SaveRateCommand}" Margin="0,0,8,8" /><ui:JournalButton Label="Обновить тариф" Command="{Binding RefreshRateCommand}" Margin="0,0,0,8" /></WrapPanel>
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" Classes="panel" Padding="12">
                  <Grid ColumnDefinitions="*,12,110,12,Auto,8,Auto" RowDefinitions="Auto,8,Auto">
                    <TextBlock Grid.ColumnSpan="7" DataContext="{Binding SelectedDraft}" x:DataType="vm:SpecificationDraft" Text="{Binding CalculationError}" TextWrapping="Wrap" Foreground="{DynamicResource JournalDangerForeground}" />
                    <StackPanel Grid.Row="2" DataContext="{Binding SelectedDraft}" x:DataType="vm:SpecificationDraft"><TextBlock Text="Резка" Classes="muted" /><TextBlock Text="{Binding TotalText}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2" Spacing="4" DataContext="{Binding SelectedDraft}" x:DataType="vm:SpecificationDraft"><TextBlock Text="Коэффициент" Classes="muted" /><TextBox Text="{Binding Coefficient}" AutomationProperties.Name="Ручной коэффициент спецификации" /></StackPanel>
                    <ui:JournalButton x:Name="SaveWorkflowSpecification" Grid.Row="2" Grid.Column="4" Label="Сохранить версию" Classes="primary" Command="{Binding SaveSpecificationCommand}" VerticalAlignment="Bottom" />
                    <ui:JournalButton Grid.Row="2" Grid.Column="6" Label="Отмена" Command="{Binding CancelDraftCommand}" VerticalAlignment="Bottom" />
                  </Grid>
                </Border>
              </Grid>
            </Grid>
          </TabItem>
          <TabItem Header="История">
            <Grid RowDefinitions="Auto,8,200,12,*" ColumnDefinitions="*,16,*" Margin="0,8,0,0">
              <ui:JournalButton Label="Открыть принятую спецификацию" Click="OnOpenArchivedReport" IsEnabled="{Binding HasArchivedReport}" HorizontalAlignment="Left" />
              <DataGrid Grid.Row="2" Grid.ColumnSpan="3" ItemsSource="{Binding Revisions}" SelectedItem="{Binding SelectedRevision}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns><DataGridTextColumn Header="Спецификация" Binding="{Binding Document}" Width="160" /><DataGridTextColumn Header="Версия" Binding="{Binding Version}" Width="90" /><DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="130" /><DataGridTextColumn Header="Сохранена" Binding="{Binding At}" Width="180" /><DataGridTextColumn Header="Станок" Binding="{Binding Machine}" Width="140" /><DataGridTextColumn Header="Стоимость, ₽" Binding="{Binding Price}" Width="*" /></DataGrid.Columns>
              </DataGrid>
              <DataGrid Grid.Row="4" ItemsSource="{Binding Comparison}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Параметр" Binding="{Binding Field}" Width="*" /><DataGridTextColumn Header="Было" Binding="{Binding Before}" Width="*" /><DataGridTextColumn Header="Стало" Binding="{Binding After}" Width="*" /></DataGrid.Columns></DataGrid>
              <ListBox Grid.Row="4" Grid.Column="2" ItemsSource="{Binding Events}" />
            </Grid>
          </TabItem>
          <TabItem Header="Письмо">
            <TextBox Text="{Binding ResultText}" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Margin="0,8,0,0" VerticalAlignment="Stretch" AutomationProperties.Name="Результат для письма" />
          </TabItem>
        </TabControl>
        <Border Grid.Row="6" Classes="panel" Padding="12">
          <Grid ColumnDefinitions="*,12,Auto,8,Auto,8,Auto" RowDefinitions="Auto,Auto">
            <StackPanel Spacing="2"><TextBlock Text="{Binding TotalText}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding BendingText}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="Данные изменились — сформируйте результат заново" TextWrapping="Wrap" IsVisible="{Binding ResultIsStale}" Foreground="{DynamicResource JournalDangerForeground}" />
            </StackPanel>
            <ui:JournalButton Grid.Column="2" Label="Результат" Command="{Binding GenerateResultCommand}" /><ToggleButton Grid.Column="4" Content="Текст" IsChecked="{Binding IsResultExpanded}" ToolTip.Tip="Показать или свернуть текст письма" /><ui:JournalButton Grid.Column="6" Icon="copy" IconOnly="True" Width="36" Click="OnCopyResult" ToolTip.Tip="Копировать результат" AutomationProperties.Name="Копировать результат" />
          </Grid>
        </Border>
      </Grid>
      </Grid>
    </Grid>
    <ProgressBar Grid.Row="3" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" />
    <TextBlock Grid.Row="4" Margin="20,0" Text="{Binding PriceSourceDescription}" Classes="muted" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="Тарифы загружаются вручную через Станки и цены → Импорт цен из прежней БД. Заявки нового журнала хранятся отдельно." />
  </Grid>
</Window>
