<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:Jornal.Desktop.Controls" x:Class="Jornal.Workflow.Desktop.WorkflowOfficeCleanupWindow"
        Title="Освободить место" Width="530" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource JournalBackground}">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock Text="Локальные копии проектов" FontSize="20" FontWeight="SemiBold" />
    <TextBlock x:Name="CleanupSummary" TextWrapping="Wrap" />
    <TextBlock x:Name="CleanupHint" Classes="muted" TextWrapping="Wrap" IsVisible="False"
               Text="Закройте открытые файлы этих проектов. При следующем открытии папки файлы снова скачаются из офиса." />
    <Expander x:Name="CleanupCandidates" Header="Копии для удаления" IsVisible="False">
      <ScrollViewer MaxHeight="140" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <SelectableTextBlock x:Name="CleanupCopyNames" TextWrapping="Wrap" />
      </ScrollViewer>
    </Expander>
    <ProgressBar x:Name="CleanupProgress" Height="5" IsIndeterminate="True" IsVisible="False" />
    <StackPanel x:Name="CleanupDetails" Spacing="6" IsVisible="False">
      <TextBlock x:Name="CleanupSkippedCount" FontWeight="SemiBold" />
      <ScrollViewer MaxHeight="160" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <SelectableTextBlock x:Name="CleanupSkipped" Classes="muted" TextWrapping="Wrap" />
      </ScrollViewer>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <ui:JournalButton x:Name="CancelCleanup" Label="Отмена" Click="OnCancel" />
      <ui:JournalButton x:Name="ConfirmCleanup" Label="Освободить место" Classes="primary" IsVisible="False" Click="OnConfirm" />
    </StackPanel>
  </StackPanel>
</Window>
