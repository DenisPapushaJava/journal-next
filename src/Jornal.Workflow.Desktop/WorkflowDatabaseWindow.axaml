<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Jornal.Workflow.Desktop" xmlns:ui="using:Jornal.Desktop.Controls"
        x:Class="Jornal.Workflow.Desktop.WorkflowDatabaseWindow" x:DataType="vm:WorkflowDatabaseViewModel"
        Title="Импорт цен из прежней БД" Width="840" Height="700" MinWidth="640" MinHeight="520"
        Background="{DynamicResource JournalBackground}" WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Classes="settings-page-header">
      <StackPanel Spacing="6"><TextBlock Text="Импорт прежних цен" Classes="settings-page-title" />
        <TextBlock Text="Источник станков, толщин и цен за метр" Classes="muted" />
      </StackPanel>
    </Border>
    <Grid Grid.Row="1" Margin="24,16" RowDefinitions="Auto,8,Auto,12,Auto,12,*,8,Auto,8,Auto,6,4">
      <TextBlock Text="База прежнего журнала" />
      <Grid Grid.Row="2" ColumnDefinitions="*,8,Auto,8,Auto" IsEnabled="{Binding CanEdit}">
        <TextBox x:Name="WorkflowPriceDatabasePath" Text="{Binding DatabasePath}" PlaceholderText="Полный путь к OrderDB.mdb" />
        <ui:JournalButton Grid.Column="2" Label="Обзор…" Click="OnBrowse" />
        <ui:JournalButton Grid.Column="4" Label="Проверить" Command="{Binding ReadCommand}" />
      </Grid>
      <TextBlock Grid.Row="4" Text="Источник открывается только для чтения. Цены за метр заменят соответствующие тарифы нового журнала. Ранее загруженные тарифы, которых больше нет в источнике, будут убраны из текущего прайса. Для новых тарифов пробивка стоит 1 ₽; уже настроенные цены пробивок сохранятся. Прежние расчёты не изменятся."
                 TextWrapping="Wrap" Classes="muted" />
      <DataGrid x:Name="WorkflowLegacyPricesGrid" Grid.Row="6" ItemsSource="{Binding Prices}" AutoGenerateColumns="False" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Станок" Binding="{Binding Machine}" Width="*" />
          <DataGridTextColumn Header="Категория материала" Binding="{Binding MaterialGroup}" Width="*" />
          <DataGridTextColumn Header="Толщина, мм" Binding="{Binding Thickness}" Width="110" />
          <DataGridTextColumn Header="Цена, ₽/м" Binding="{Binding MeterPrice}" Width="110" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="8" Text="{Binding Status}" TextWrapping="Wrap" />
      <TextBlock Grid.Row="10" Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource JournalDangerForeground}" />
      <ProgressBar Grid.Row="12" IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="4" />
    </Grid>
    <Border Grid.Row="2" Padding="24,12" Background="{DynamicResource JournalSurface}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource JournalBorder}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <ui:JournalButton x:Name="ImportWorkflowPrices" Label="Загрузить цены" Classes="primary" Command="{Binding ImportCommand}" />
        <ui:JournalButton Label="Закрыть" Click="OnClose" IsEnabled="{Binding !IsApplying}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
