<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Jornal.Desktop.ViewModels" xmlns:ui="using:Jornal.Desktop.Controls"
             x:Class="Jornal.Workflow.Desktop.WorkflowUpdatesPanel" x:DataType="vm:AppUpdatesViewModel">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Classes="settings-page-header">
      <StackPanel Spacing="4">
        <TextBlock Text="Обновления" Classes="settings-page-title" />
        <TextBlock Text="{Binding CurrentVersion, StringFormat='Текущая версия: {0}'}" Classes="muted" />
      </StackPanel>
    </Border>
    <Grid Grid.Row="1" Margin="24,16" RowDefinitions="Auto,Auto,Auto,*">
      <StackPanel Spacing="4">
        <CheckBox x:Name="WorkflowAutomaticUpdates" Content="Проверять обновления автоматически"
                  ToolTip.Tip="При запуске и каждые 6 часов" IsChecked="{Binding CheckAutomatically, Mode=TwoWay}" IsEnabled="{Binding !IsApplying}" />
        <CheckBox x:Name="WorkflowPreviewUpdates" Content="Получать тестовые версии"
                  ToolTip.Tip="Alpha, beta и rc" IsChecked="{Binding IncludePreview, Mode=TwoWay}" IsEnabled="{Binding !IsBusy}" />
        <TextBlock Text="{Binding PreferencesWarning}" IsVisible="{Binding HasPreferencesWarning}" TextWrapping="Wrap"
                   Foreground="{DynamicResource JournalDangerForeground}" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
      <StackPanel Grid.Row="1" Spacing="6" Margin="0,12,0,0">
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <ProgressBar IsVisible="{Binding IsDownloading}" Value="{Binding DownloadProgress}" Maximum="100" Height="6" AutomationProperties.Name="Загрузка обновления" />
      </StackPanel>
      <StackPanel Grid.Row="2" IsVisible="{Binding !IsInstalled}" Spacing="8" Margin="0,12,0,0">
        <TextBlock Text="Обновления доступны после установки через OfflineSetup." Classes="muted" TextWrapping="Wrap" />
        <ui:JournalButton x:Name="OpenWorkflowReleases" Label="Открыть выпуски на GitHub" Click="OnOpenReleases" HorizontalAlignment="Left" />
      </StackPanel>
      <Border Grid.Row="3" Classes="panel" Padding="12" Margin="0,16,0,0" IsVisible="{Binding HasUpdate}">
        <Grid RowDefinitions="Auto,8,*">
          <TextBlock Text="{Binding AvailableVersion, StringFormat='Что нового в {0}'}" FontWeight="SemiBold" />
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="WorkflowReleaseNotes" Text="{Binding ReleaseNotes}" TextWrapping="Wrap" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource JournalSurface}" BorderBrush="{DynamicResource JournalBorder}" BorderThickness="0,1,0,0" Padding="24,12">
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                   Foreground="{DynamicResource JournalDangerForeground}" AutomationProperties.LiveSetting="Polite" />
        <WrapPanel>
          <ui:JournalButton x:Name="CheckWorkflowUpdates" Label="Проверить обновления" Command="{Binding CheckCommand}" Margin="0,0,8,0" />
          <WrapPanel IsVisible="{Binding HasUpdate}">
            <ui:JournalButton x:Name="DownloadWorkflowUpdate" Label="Скачать" Classes="primary" Command="{Binding DownloadCommand}" IsVisible="{Binding !IsDownloaded}" />
            <ui:JournalButton x:Name="InstallWorkflowUpdate" Label="Установить и перезапустить" Classes="primary" Command="{Binding InstallCommand}" IsVisible="{Binding IsDownloaded}" />
            <ui:JournalButton x:Name="CancelWorkflowDownload" Label="Отменить загрузку" Command="{Binding DownloadCancelCommand}" IsVisible="{Binding IsDownloading}" Margin="8,0,0,0" />
          </WrapPanel>
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
