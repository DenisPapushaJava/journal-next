    <PackageVersion Include="Svg.Controls.Avalonia" Version="12.0.0.17" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageVersion Include="Velopack" Version="1.2.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="System.Data.OleDb" Version="10.0.13" />
    <PackageVersion Include="AngleSharp" Version="1.8.5" />
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
