{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Заявки: сборка Debug",
      "type": "process",
      "command": "dotnet",
      "linux": {
        "command": "${env:HOME}/.dotnet/dotnet"
      },
      "args": [
        "build",
        "${workspaceFolder}/src/Jornal.Workflow.Desktop/Jornal.Workflow.Desktop.csproj",
        "--configuration",
        "Debug",
        "-p:RestoreLockedMode=true"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
